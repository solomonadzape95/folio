GOOGLE_BOOKS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key for new projects. Legacy projects can set ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set only when deployed behind a trusted proxy that controls X-Forwarded-For.
TRUST_PROXY=false
